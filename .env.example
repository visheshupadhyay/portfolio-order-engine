# Copy this file to .env for local Docker Compose and Maven use.
# Never commit the real .env file.
ORDER_ENGINE_DB_PASSWORD=replace-with-a-local-database-password
JWT_BASE64_SECRET=replace-with-a-base64-encoded-secret
# Optional: host port for Compose PostgreSQL. Use 5433 if 5432 is already busy.
POSTGRES_HOST_PORT=5432
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-admin-password